{
  "$schema": "mc/manifest/v1",
  "repoRole": "canonical",
  "project": {
    "name": "MC",
    "slug": "mc",
    "description": "MC canonical — autonomous AI operating system framework (Alex Alpha + multi-provider agent dispatch).",
    "techStack": [
      "node"
    ],
    "framework": "mc"
  },
  "git": {
    "mainBranch": "main"
  },
  "mc": {
    "version": "2.3.1",
    "installed": true,
    "source": "self",
    "features": [
      "agents",
      "hooks",
      "skills",
      "memory",
      "maps",
      "events",
      "sprint",
      "product-bootstrap",
      "providers",
      "transactions"
    ],
    "operatorContract": {
      "enabled": true,
      "strictness": "strict",
      "maxLinesBeforeHeader": 5,
      "allowIdentifiers": false,
      "extraCommandPrefixes": []
    }
  },
  "agents": {
    "team": {
      "name": "alex",
      "identity": "Alex",
      "members": {
        "alpha": {
          "symbol": "α",
          "role": "orchestrator"
        },
        "beta": {
          "symbol": "β",
          "role": "judgment"
        },
        "gamma": {
          "symbol": "γ",
          "role": "adhoc builder"
        },
        "delta": {
          "symbol": "δ",
          "role": "oneshot builder"
        }
      }
    },
    "modes": [
      "adhoc",
      "oneshot",
      "solo"
    ],
    "build": [
      "builder",
      "reviewer",
      "compliance",
      "learner",
      "qa",
      "redteam",
      "fixer"
    ]
  },
  "source_dirs": [],
  "build": {
    "features": [],
    "phases": []
  },
  "providers": {
    "claude": {
      "cli": "claude",
      "default_model": "sonnet",
      "invocation": "native"
    },
    "openai": {
      "cli": "codex",
      "default_model": "gpt-6.1-sol",
      "fallback": "claude",
      "syntax": "codex exec --sandbox workspace-write {reasoning} -m {model} -"
    },
    "antigravity": {
      "cli": "agy",
      "default_model": "gemini-4-argon-high",
      "fallback": "openai",
      "syntax": "agy {reasoning} --model {model} --print-timeout 90s -p"
    }
  },
  "_agentProviders_note": "This project's own model pins (the project layer). Empty = every role takes its model from the shipped default preset (.claude/agents/_org/presets/default.json) and its fallback chain. A pin set with `node scripts/dispatch.js set <role> ...` is written here (never into a role spec) and wins over the preset; `set <role> --default` removes it. An in-process (Claude) pin chooses a tier: it rides at spawn time as an alias (opus / sonnet / haiku / fable). This file ships, so the release gate shipped_spec_models requires it to stay empty in the product source.",
  "agentProviders": {},
  "buildCommands": {},
  "fileOwnership": {
    "foundation": []
  }
}
