.claude/runtime/
# Addendum C (SP-20260717-001): the declared rotation/archive manifest-ignore
# class. All under .claude/runtime/ (covered above); listed explicitly so the
# class is self-documenting — the archive tier holds MOVED raw logs (D-1) and
# the locks serialize rotation/retention. Raw history is archived, never staged.
.claude/runtime/archive/
.claude/runtime/rotate-locks/
.claude/runtime/retention.lock
.claude/content/
.claude/.session-id
.claude/handoffs/
.claude/handoff.md
.claude/agents/*/events.jsonl
.claude/agents/*/.workspace/
.claude/agents/*/_system/events.jsonl
# ADR-0007 + D-2: per-agent runtime event logs live deeper under _system/<role>/ now
# (e.g. president/_system/beta/events.jsonl, president/_system/gamma/events.jsonl).
.claude/agents/**/events.jsonl
# Runtime tool-usage log under the maps dir (owner=runtime append-only).
.claude/project/maps/tools.jsonl
# Runtime coherence graph (coherence.js output, owner=runtime, walk-skipped).
.claude/project/maps/system-coherence.graph.json
.claude/logs/
.claude/worktrees/
# Per-agent teammate memory store (runtime; local like the home memory dir, not committed).
.claude/agent-memory/

# Session handoff dump (regenerable via /session:dump — do NOT commit). Anchored: an unanchored
# `DUMP.md` also matched .claude/commands/session/dump.md on case-insensitive filesystems.
/DUMP.md
# Operator-requested session export/report (local handoff, not a shipped artifact —
# was tripping mc-ship-coverage as an unclassified root .md). E-DISPATCH-PERFECT-001 W5.
REPORT-JULY-18.md
REPORT-*.md

# MC runtime/transaction/consult scratch — all per-machine transient (G5.7).
# Broad ignore so consult outputs, fixtures, ping prompts, etc. are never tracked.
.mc/
# (specific historical entries retained below; the broad rule above already covers them)
.mc/transactions/
# Plan-payload scratch input to /sprint:plan + /sprint:full orchestrator.
# Durable record lives at paths.sprintPlanContracts/PC-*.yaml; these scratch
# files often carry product slugs from the brief and would trip the
# framework-purity guard if committed.
.mc/plan-payload-*.json
runtime/qa-warp-update/

# Portfolio briefs + clones — local-only until adopted into private sibling repos
# Use /portfolio:adopt <slug> to promote into a versioned private repo.
# See C-15 (copy.md SP-20260521-001).
_docs/briefs/
_docs/clones/

# Runtime artifacts that should never be committed (T-20260522-184; mirrors
# warp-setup.js#runtimeBlock for canonical's own checkout)
.claude/.session-checkpoint.json
.claude/.session-start-commit
.claude/.last-checkpoint
.claude/.agent-result-hashes.json
.claude/project/builds/

# /etc harness (S0.4) runtime emissions — never committed. Both live under runtime/
# (walk-skipped by the manifest) so timestamped per-run files can't drift it. Dirs
# kept via .gitkeep. Authored eval-packs (.claude/project/etc/eval-packs/) stay tracked.
runtime/etc/decisions/*
!runtime/etc/decisions/.gitkeep
runtime/etc/consults/*
!runtime/etc/consults/.gitkeep

# Higgsfield render spend-approval token (S2.2). Operator-placed, per-machine,
# secret-ish — authorizes a oneshot fan-out ≥ $5 (scripts/checks/higgsfield-spend-gate.js).
# Never committed (same posture as the ~/.higgsfield/.env credential).
runtime/growth/spend-approval.token

# Install matrix ephemeral fixtures (SP-20260524-001). The runner creates a
# per-scenario timestamped dir under .mc/test-fixtures/install-matrix/;
# failed scenarios are moved to .mc/test-fixtures/install-matrix/_failed/.
# All ephemeral — should never be committed.
.mc/test-fixtures/

# Ad-hoc throwaway MC installs from manual install-gap testing (git-init'd
# temp dirs, e.g. .mc/_gh3/). Ephemeral — never commit. (Prefer
# .mc/test-fixtures/ for new throwaways; this covers stray manual ones.)
.mc/_gh*/

# Operator scratch — downstream gap registers (gap-fix landed; kept for reference, not framework content)
MC-Update/

# research:deep per-run scratch under _docs/research — deliverables (*.md/*.json) kept, scratch transient
_docs/research/.tmp-*
_docs/research/**/*.log
_docs/research/**/.session.json
_docs/research/**/.deep-runner.sh

# per-run scratch (research/scan-runs/skill-runs/sprint-notes) — never commit
runtime/research/
runtime/scan-runs/
runtime/skill-runs/
runtime/sprint/
runtime/notes/
# agent-system-plan is scratch EXCEPT tooltest/ (the seeded fixture for the scan:tools self-test)
runtime/agent-system-plan/*
!runtime/agent-system-plan/tooltest/

# ── Secrets / keys / credentials / backups — defense-in-depth (operator-requested) ──
# Real credentials live OUTSIDE the repo (~/.gemini/.env, ~/.codex/auth.json, etc.).
# These patterns stop any in-repo key/secret/backup from ever being swept in (cf. the
# 2026-06-08 `git add -A` scratch-leak). Example/sample/template variants are placeholders,
# not secrets, and don't match these patterns, so they stay tracked
# (e.g. _mc/templates/app-scaffold/.env.local.example.tmpl).
*.key
*.pem
*.p12
*.pfx
*.keystore
*.jks
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
*.ppk
auth.json
.auth.json
secrets.json
secrets.yaml
secrets.yml
credentials.json
*-credentials.json
# Backups / editor-swap / settings-backup rings
*.bak
*.backup
*.orig
*~

# ── Crud-sweep 2026-07-16 (GITIGNORE-ONLY lever, β 4×DECIDE) ──
