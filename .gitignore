# runtime fixtures (agent-system-plan/, diagnostic/, models-research/, notes/,
# mc-v1-discovery/, sp002-dispatch/WSG*, sp-dp-*/*-out.md|*-prompt.md, etc.).
.codex/
CODEX-LOG.md
MC-v1/
