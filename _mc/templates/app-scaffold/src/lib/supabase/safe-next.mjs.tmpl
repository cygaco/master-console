// safe-next.mjs - open-redirect defense for the `?next=` param on the auth callback.
//
// SECURITY (CWE-601). Two distinct vectors on one function, both from the
// same fragile SEAM: "validate one value, return a DIFFERENT value the caller re-derives."
//   A control-char payload: a leading-slash guard that runs BEFORE new URL() strips CR/LF/TAB lets
//           `/%0D/evil.com` (decoded `/\r/evil.com`) pass the guard and then parse to `//evil.com`.
//   A same-origin absolute with a //evil.com pathname: returning the RELATIVE pathname of a
//           validated-same-origin absolute URL - for `https://app.example.com//evil.com` the origin
//           check PASSES (host is the app) but the pathname is `//evil.com`, and a caller's
//           `new URL(pathname, origin)` RE-PARSES that protocol-relative string to https://evil.com/.
//
// Design: return the VALIDATED ABSOLUTE
// URL OBJECT, and have the caller redirect to it DIRECTLY (no re-parse anywhere). The value we
// validate IS the value the caller consumes - so there is no re-parse seam for a redirect to
// live in. Closes both vectors, and any future re-parse variant, by construction. Pure +
// isolated (no Next/Supabase imports) so it is unit-testable.

/** @type {string} */
export const DEFAULT_NEXT = "/account";

// Any C0 control char (U+0000..U+001F) - the URL parser strips TAB/LF/CR mid-parse. Built from
// char codes so no literal control byte is ever written into the source.
const CONTROL_CHARS = new RegExp("[" + "\\u0000-\\u001F" + "]");

/**
 * Resolve the `next` redirect target to a VALIDATED same-origin absolute URL OBJECT (or the
 * DEFAULT_NEXT URL). The caller MUST redirect to the returned object directly - never re-parse
 * a string derived from it (that re-parse is the open-redirect seam).
 * @param {string | null | undefined} raw  the raw `next` query param (already URL-decoded by searchParams.get)
 * @param {string} origin  the app origin (e.g. url.origin)
 * @returns {URL} a same-origin absolute URL to redirect to
 */
export function safeNextUrl(raw, origin) {
  const fallback = new URL(DEFAULT_NEXT, origin);
  if (!raw) return fallback;
  // Reject control chars BEFORE parsing - kills the strip-mid-parse vector.
  if (CONTROL_CHARS.test(raw)) return fallback;
  try {
    const u = new URL(raw, origin);
    // Same-origin ONLY. Return the OBJECT (not u.pathname) so the caller redirects to exactly
    // what we validated - no protocol-relative re-parse.
    return u.origin === origin ? u : fallback;
  } catch {
    return fallback;
  }
}
