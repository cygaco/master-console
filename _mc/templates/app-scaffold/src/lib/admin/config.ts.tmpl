import { createHmac, timingSafeEqual } from "node:crypto";
import { cookies } from "next/headers";

export type AdminActor = {
  email: string;
  allowed: boolean;
  source: "signed-cookie" | "dev-env" | "missing";
};

export type AdminFeatureFlag = {
  key: string;
  label: string;
  enabled: boolean;
};

export const ADMIN_FEATURE_FLAGS: AdminFeatureFlag[] = [
  {
    key: "admin.project_sections",
    label: "Project sections",
    enabled: true,
  },
  {
    key: "admin.event_feed",
    label: "Event feed",
    enabled: true,
  },
];

const DEFAULT_ADMIN_SESSION_COOKIE = "mc_admin_session";

function normalizeEmail(email: string): string {
  return email.trim().toLowerCase();
}

function splitEmails(value: string | undefined): string[] {
  return (value || "")
    .split(/[,\s]+/)
    .map(normalizeEmail)
    .filter(Boolean);
}

export function founderEmailAllowlist(): string[] {
  return splitEmails(process.env.ADMIN_FOUNDER_EMAILS);
}

export function adminSessionCookieName(): string {
  return (
    process.env.ADMIN_SESSION_COOKIE || DEFAULT_ADMIN_SESSION_COOKIE
  ).trim();
}

export function isFounderEmailAllowed(email: string | null | undefined): boolean {
  const normalized = normalizeEmail(email || "");
  return Boolean(normalized && founderEmailAllowlist().includes(normalized));
}

function adminSessionSecret(): string {
  return (process.env.ADMIN_SESSION_SECRET || "").trim();
}

// Session lifetime + revocation. A signed admin cookie is bound to (email, iat, version):
//   - iat + ADMIN_SESSION_MAX_AGE_SECONDS gives expiry, so a LEAKED cookie is NOT a
//     permanent skeleton key — it stops working after the window.
//   - ADMIN_SESSION_VERSION is a revocation lever: bump it (env) to invalidate EVERY
//     issued session at once (e.g. after a suspected leak), with no per-user state.
export const ADMIN_SESSION_MAX_AGE_SECONDS = 60 * 60 * 24 * 7; // 7 days
const ADMIN_SESSION_CLOCK_SKEW_SECONDS = 300; // tolerate 5m of forward clock skew

function adminSessionVersion(): string {
  return (process.env.ADMIN_SESSION_VERSION || "1").trim();
}

// The signature binds email|iat|version — tampering with ANY field breaks it.
function signAdminPayload(email: string, iat: number, version: string, secret: string): string {
  return createHmac("sha256", secret).update(`${email}|${iat}|${version}`).digest("base64url");
}

function safeEqual(a: string, b: string): boolean {
  const left = Buffer.from(a);
  const right = Buffer.from(b);
  return left.length === right.length && timingSafeEqual(left, right);
}

export function verifyAdminSessionCookie(value: string | undefined): string | null {
  const secret = adminSessionSecret();
  if (!secret || !value) return null;

  // Format: base64url(email).iat.version.signature
  const parts = value.split(".");
  if (parts.length !== 4) return null;
  const [encodedEmail, iatRaw, version, signature] = parts;
  const email = normalizeEmail(Buffer.from(encodedEmail, "base64url").toString("utf8"));
  // Require a CANONICAL all-digits iat (reject "123abc"-style non-canonical inputs up front).
  if (!email || !signature || !/^\d+$/.test(iatRaw)) return null;
  const iat = Number.parseInt(iatRaw, 10);
  if (!Number.isFinite(iat)) return null;

  // Revocation: a token signed under a retired version is rejected.
  if (version !== adminSessionVersion()) return null;

  // Expiry: reject an aged-out token (the leaked-cookie-is-forever fix) and a future-dated
  // one (beyond a small skew) so a forged iat cannot extend the validity window.
  const now = Math.floor(Date.now() / 1000);
  if (now - iat > ADMIN_SESSION_MAX_AGE_SECONDS) return null;
  if (iat - now > ADMIN_SESSION_CLOCK_SKEW_SECONDS) return null;

  const expectedSignature = signAdminPayload(email, iat, version, secret);
  return safeEqual(signature, expectedSignature) ? email : null;
}

export function signAdminSessionEmail(email: string): string | null {
  const secret = adminSessionSecret();
  const normalizedEmail = normalizeEmail(email);
  if (!secret || !normalizedEmail) return null;

  const iat = Math.floor(Date.now() / 1000);
  const version = adminSessionVersion();
  const encodedEmail = Buffer.from(normalizedEmail).toString("base64url");
  return `${encodedEmail}.${iat}.${version}.${signAdminPayload(normalizedEmail, iat, version, secret)}`;
}

// Reference session issuance — sets the signed cookie with the security flags a founder
// hand-rolling a login route would otherwise miss: HttpOnly (blocks JS/XSS theft), Secure
// (HTTPS-only in prod), SameSite=lax (blunts CSRF), Max-Age (matches the token expiry).
// Call from your founder-login handler AFTER verifying the email is allowlisted.
export async function setAdminSessionCookie(email: string): Promise<boolean> {
  const value = signAdminSessionEmail(email);
  if (!value) return false;
  const jar = await cookies();
  jar.set(adminSessionCookieName(), value, {
    httpOnly: true,
    secure: process.env.NODE_ENV === "production",
    sameSite: "lax",
    path: "/",
    maxAge: ADMIN_SESSION_MAX_AGE_SECONDS,
  });
  return true;
}

export async function clearAdminSessionCookie(): Promise<void> {
  const jar = await cookies();
  jar.delete(adminSessionCookieName());
}

export async function resolveAdminActor(): Promise<AdminActor> {
  const requestCookies = await cookies();
  const sessionEmail = verifyAdminSessionCookie(
    requestCookies.get(adminSessionCookieName())?.value,
  );
  const devEmail =
    process.env.NODE_ENV !== "production"
      ? normalizeEmail(process.env.ADMIN_DEV_EMAIL || "")
      : "";
  const email = sessionEmail || devEmail;
  return {
    email,
    allowed: isFounderEmailAllowed(email),
    source: sessionEmail ? "signed-cookie" : devEmail ? "dev-env" : "missing",
  };
}

export async function requireFounderAdmin(): Promise<AdminActor> {
  const actor = await resolveAdminActor();
  if (!actor.allowed) {
    throw new Error("Admin access denied: founder email is not allowlisted");
  }
  return actor;
}
