"use client";

import { Rocket } from "lucide-react";
import { Button } from "@/components/ui/button";
import {
  Card,
  CardContent,
  CardDescription,
  CardHeader,
  CardTitle,
} from "@/components/ui/card";
import { evaluateTelemetryChain } from "@/lib/telemetry/chain";
import {
  ACTIVATION_DEFINITION,
  SUPPLY_CHAIN_STAGES,
} from "@/lib/telemetry/events";
import { track } from "@/lib/telemetry/track";

const CORE_LOOP_EXAMPLE_ID = "{{SLUG}}-core-loop-example";

function handleCoreLoopExample() {
  const correlationId = CORE_LOOP_EXAMPLE_ID;
  const records = SUPPLY_CHAIN_STAGES.map((stage) => {
    track("core_action", {
      correlationId,
      stage,
      activationPredicate: ACTIVATION_DEFINITION.predicate,
    });
    return { correlationId, stage };
  });

  const chain = evaluateTelemetryChain(records);
  if (!chain.ok) {
    track(chain.failureEvent.event, chain.failureEvent.props);
    return;
  }

  track("activation", {
    correlationId,
    activationPredicate: ACTIVATION_DEFINITION.predicate,
    provenance: ACTIVATION_DEFINITION.provenance,
    confidence: ACTIVATION_DEFINITION.confidence,
    derivedFrom: ACTIVATION_DEFINITION.derivedFrom,
  });
}

export default function Home() {
  return (
    <main className="mx-auto flex min-h-screen max-w-2xl flex-col items-center justify-center gap-6 p-8">
      <Card className="w-full">
        <CardHeader>
          <CardTitle className="flex items-center gap-2">
            <Rocket className="size-5" aria-hidden />{" "}
            <span>{{SLUG}}</span>
          </CardTitle>
          <CardDescription>
            Scaffolded with MC - Next.js App Router, Tailwind v4, shadcn/ui,
            Radix, Lucide. Build on the primitives in{" "}
            <code className="rounded bg-muted px-1 py-0.5 text-sm">
              src/components/ui
            </code>{" "}
            - never hand-roll a raw &lt;button&gt; or &lt;input&gt;.
          </CardDescription>
        </CardHeader>
        <CardContent className="flex flex-wrap gap-3">
          <Button onClick={handleCoreLoopExample}>Primary</Button>
          <Button variant="secondary">Secondary</Button>
          <Button variant="outline">Outline</Button>
          <Button variant="ghost">Ghost</Button>
        </CardContent>
      </Card>
    </main>
  );
}
