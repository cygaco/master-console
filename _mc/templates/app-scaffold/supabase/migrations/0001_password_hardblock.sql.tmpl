-- 0001_password_hardblock.sql — AUTH PASSWORD HARD-BLOCK (security spine)
-- =============================================================================
-- THREAT: Supabase Auth with "Confirm email = OFF" auto-confirms every signup.
-- If the anon-key email+password signup surface stays open, an attacker can
-- pre-create (or hijack) an account for a victim's email BEFORE the victim ever
-- signs up — the classic pre-account-takeover class (Sudhodanan & Paverd). When
-- the victim later arrives via the intended passwordless flow, they land on an
-- account the attacker already controls the password for.
--
-- FIX: remove the password path from the database entirely. This trigger fires
-- BEFORE INSERT OR UPDATE on auth.users and forces encrypted_password to NULL on
-- every write, so no password credential can ever be stored — regardless of what
-- the anon key or any client sends. The passwordless flow (email OTP + Google
-- OAuth) is UNAFFECTED: those paths never populate encrypted_password.
--
-- PAIRS WITH: Supabase project setting "Confirm email = OFF" (auto-confirm). This
-- migration is what makes that setting SAFE. Verify installation before deploy
-- with scripts/verify-auth-hardblock.mjs (fail-closed predeploy gate).
--
-- Idempotent: CREATE OR REPLACE FUNCTION + DROP TRIGGER IF EXISTS / CREATE TRIGGER.
-- Re-running this migration is a no-op that re-asserts the hard-block.
-- =============================================================================

CREATE OR REPLACE FUNCTION public.hardblock_password()
RETURNS trigger
LANGUAGE plpgsql
SECURITY DEFINER
SET search_path = ''
AS $$
BEGIN
  -- Strip any password credential on the way in. NEW is mutable in a BEFORE
  -- row-level trigger, so nulling it here means the row is persisted without a
  -- password. This closes the pre-account-takeover surface at the database.
  NEW.encrypted_password := NULL;
  RETURN NEW;
END;
$$;

DROP TRIGGER IF EXISTS hardblock_password_trigger ON auth.users;

CREATE TRIGGER hardblock_password_trigger
  BEFORE INSERT OR UPDATE ON auth.users
  FOR EACH ROW
  EXECUTE FUNCTION public.hardblock_password();
